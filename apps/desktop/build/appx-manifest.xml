<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package's manifest: electron-builder's own template (app-builder-lib/templates/appx), plus what
  Tost Work needs inside a package. electron-builder fills in the ${…} values from electron-builder.yml.

  - AppData writes are virtualized in a package: new files go to a private copy that only the app sees and that goes
    away on uninstall. The app's data, the AI tools' own folders under it, and Codex's install folder must stay where
    other programs can see them, because Codex and Claude Code run as programs of their own and the user runs them from
    a terminal too. Windows 11 reads the folder list; Windows 10 ignores it and reads the older switches, which turn
    virtualization off for all of AppData. HKCU\Environment is where the installers add themselves to the PATH.
  - The alias "tost-work.exe" starts the app inside its package from a command line, which CI's smoke test needs.
  - The startup task is how a packaged app starts at login; main/startupTask.ts turns it on and off with the setting.
    It's off until then. uap10:Parameters asks Windows to pass the flag that opens the app without its window; on a
    Windows that ignores it there, the app opens its window at login.
-->
<Package
   xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
   xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
   xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
   xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
   xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
   xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
   xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
   xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
   IgnorableNamespaces="uap3 uap10 desktop6 rescap virtualization">
  <Identity Name="${identityName}"
    ProcessorArchitecture="${arch}"
    Publisher="${publisher}"
    Version="${version}" />
  <Properties>
    <DisplayName>${displayName}</DisplayName>
    <PublisherDisplayName>${publisherDisplayName}</PublisherDisplayName>
    <Description>${description}</Description>
    <Logo>${logo}</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\Tost Work</virtualization:ExcludedDirectory>
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\Programs\OpenAI</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
    <virtualization:RegistryWriteVirtualization>
      <virtualization:ExcludedKeys>
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Environment</virtualization:ExcludedKey>
      </virtualization:ExcludedKeys>
    </virtualization:RegistryWriteVirtualization>
  </Properties>
  <Resources>
    ${resourceLanguages}
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="${minVersion}" MaxVersionTested="${maxVersionTested}" />
  </Dependencies>
  ${capabilities}
  <Applications>
    <Application Id="${applicationId}" Executable="${executable}" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
       BackgroundColor="${backgroundColor}"
       DisplayName="${displayName}"
       Square150x150Logo="${square150x150Logo}"
       Square44x44Logo="${square44x44Logo}"
       Description="${description}">
        ${lockScreen}
        ${defaultTile}
        ${splashScreen}
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="${executable}" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="tost-work.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="${executable}" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--at-login">
          <desktop:StartupTask TaskId="TostWorkStartup" Enabled="false" DisplayName="${displayName}" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
